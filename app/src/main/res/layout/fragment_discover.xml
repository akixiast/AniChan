<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/discoverScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/marginFar">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/marginPageNormal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/discoverSearchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/marginNormal"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/marginNormal"
                app:strokeWidth="@dimen/lineWidth"
                app:strokeColor="?themeDividerColor"
                app:cardBackgroundColor="?themeCardColor">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:foreground="?android:selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        app:srcCompat="@drawable/ic_search"
                        app:tint="?themeContentColor"
                        android:layout_marginEnd="@dimen/marginSmall"
                        android:layout_width="@dimen/iconSmallSize"
                        android:layout_height="@dimen/iconSmallSize"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:text="@string/what_are_you_looking_for"
                        style="?themeRegularFont"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:text="@string/discover_browse_title"
                style="?themeRegularBoldFont"
                android:layout_marginTop="@dimen/marginNormal"
                android:layout_marginBottom="@dimen/marginNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <GridLayout
                android:columnCount="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:layout_margin="@dimen/marginClose"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:contentPadding="@dimen/marginNormal"
                    app:cardBackgroundColor="?themeCardColor">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/discoverSeasonalCard"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?android:selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            app:srcCompat="@drawable/ic_baseline_dashboard"
                            app:tint="?themePrimaryColor"
                            android:layout_width="48dp"
                            android:layout_height="48dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:text="@string/seasonal"
                            style="?themeRegularBoldFont"
                            android:layout_marginTop="@dimen/marginClose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_margin="@dimen/marginClose"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:contentPadding="@dimen/marginNormal"
                    app:cardBackgroundColor="?themeCardColor">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/discoverExploreCard"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?android:selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            app:srcCompat="@drawable/ic_compass"
                            app:tint="?themePrimaryColor"
                            android:layout_width="48dp"
                            android:layout_height="48dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:text="@string/explore"
                            style="?themeRegularBoldFont"
                            android:layout_marginTop="@dimen/marginClose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_margin="@dimen/marginClose"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:contentPadding="@dimen/marginNormal"
                    app:cardBackgroundColor="?themeCardColor">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/discoverCalendarCard"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?android:selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            app:srcCompat="@drawable/ic_calendar"
                            app:tint="?themePrimaryColor"
                            android:layout_width="48dp"
                            android:layout_height="48dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:text="@string/calendar"
                            style="?themeRegularBoldFont"
                            android:layout_marginTop="@dimen/marginClose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_margin="@dimen/marginClose"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:contentPadding="@dimen/marginNormal"
                    app:cardBackgroundColor="?themeCardColor">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/discoverReviewsCard"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?android:selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            app:srcCompat="@drawable/ic_inscription"
                            app:tint="?themePrimaryColor"
                            android:layout_width="48dp"
                            android:layout_height="48dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:text="@string/reviews"
                            style="?themeRegularBoldFont"
                            android:layout_marginTop="@dimen/marginClose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <com.google.android.material.textview.MaterialTextView
                android:text="@string/social_hub"
                style="?themeRegularBoldFont"
                android:layout_marginTop="@dimen/marginFar"
                android:layout_marginBottom="@dimen/marginNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/marginNormal"
                app:cardBackgroundColor="?themeCardColor">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/discoverSocialCard"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:foreground="?android:selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        app:srcCompat="@drawable/ic_person"
                        app:tint="?themePrimaryColor"
                        android:layout_width="48dp"
                        android:layout_height="48dp" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/marginNormal"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textview.MaterialTextView
                            android:text="@string/social_hub"
                            style="?themeRegularBoldFont"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.textview.MaterialTextView
                            android:text="@string/social_hub_subtitle"
                            style="?themeSmallFont"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.AppCompatImageView
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="?themePrimaryColor"
                        android:layout_width="24dp"
                        android:layout_height="24dp" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
